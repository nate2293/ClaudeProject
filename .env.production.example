# Production environment template. Copy the values into your host's environment
# settings (or a .env on the server); never commit real secrets.
# See docs/deployment.md for the full checklist.

APP_NAME="Loom & Lane"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://shop.example.com

# Visitors reach the app through a load balancer/CDN: trust its forwarded
# headers so rate limits see real IPs and URLs are generated as https.
# Use the proxy's IP ranges, or "*" if the app is only reachable through it.
TRUSTED_PROXIES=*

# Logs to stdout/stderr for the host's log viewer, warnings and above to Sentry.
LOG_CHANNEL=stack
LOG_STACK=stderr,sentry
LOG_LEVEL=info
LOG_SENTRY_LEVEL=warning
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Managed PostgreSQL with automatic backups / point-in-time recovery.
DB_CONNECTION=pgsql
DB_URL=                       # or DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD
DB_SSLMODE=require

# Managed Redis for sessions, cache, locks, rate limits and queues.
REDIS_CLIENT=phpredis
REDIS_URL=                    # or REDIS_HOST / REDIS_PASSWORD / REDIS_PORT
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Shared maintenance mode: `php artisan down` on one server takes them all down.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# Product photos on S3 (or R2 / any S3-compatible store) behind a CDN.
FILESYSTEM_DISK=s3
SHOP_MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_URL=https://media.example.com   # the CDN in front of the bucket
AWS_ENDPOINT=                        # only for R2 / other S3-compatible stores
AWS_USE_PATH_STYLE_ENDPOINT=false

# Serve built JS/CSS from a CDN pulling from APP_URL (optional).
ASSET_URL=

# Scheduler heartbeats: monitors that alert when a ping stops arriving.
HEARTBEAT_RECONCILE_CHECKOUTS_URL=
HEARTBEAT_PRUNE_ORDERS_URL=

# Search engine (https://www.meilisearch.com, self-hosted or Meilisearch Cloud).
# Leave SCOUT_DRIVER=null to keep the built-in database search.
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true                      # index on the queue, so a search outage never blocks saving a product
MEILISEARCH_HOST=
MEILISEARCH_KEY=                      # an API key with search + documents access, not the master key

SHOP_CURRENCY=gbp
# How long checkout holds stock (Stripe allows 30 minutes to 24 hours).
SHOP_RESERVATION_MINUTES=30

# "Continue with Google": OAuth client from Google Cloud Console (docs/deployment.md, section 6).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Live Stripe keys (https://dashboard.stripe.com/apikeys). Prefer a restricted key.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Email through Resend (https://resend.com); see docs/deployment.md section 5.
MAIL_MAILER=resend
RESEND_KEY=                              # an API key with "Sending access" only
MAIL_FROM_ADDRESS="orders@example.com"   # on your verified sending domain
MAIL_FROM_NAME="${APP_NAME}"

# Legal details shown on the privacy policy, terms and emails.
SHOP_LEGAL_NAME="Loom & Lane Ltd"
SHOP_ADDRESS=
SHOP_CONTACT_EMAIL=
SHOP_COMPANY_NUMBER=
SHOP_VAT_NUMBER=
SHOP_VAT_RATE_BPS=2000                   # 20%; 0 if not VAT-registered
SHOP_ICO_NUMBER=
SHOP_HOSTING_PROVIDER=
SHOP_EMAIL_PROVIDER=Resend
